# Django Secret Key (Generate a random string)
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key

# Production flag (False in production)
DEBUG=False

# Allowed hosts (comma-separated domains)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Database URL (Render / Supabase / Neon / Railway PostgreSQL connection string)
# Example: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Allowed CORS origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOW_ALL_ORIGINS=True
